# SERVER-SIDE ONLY. Add in Vercel > Project Settings > Environment Variables.
# Do not put any of these values in public/ or Git source control.
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cassia_operations
RESEND_API_KEY=re_************************
EMAIL_FROM=Cassia Control <login@your-verified-domain.com>
APP_BASE_URL=https://your-private-cassia-control.vercel.app
ADMIN_NAME=Swastik Shukla
ADMIN_EMAIL=swastikshukla522@gmail.com
SESSION_SECRET=replace-with-64-plus-cryptographically-random-characters
NODE_ENV=production
SESSION_COOKIE_SECURE=true

# Use ONLY for a password-protected, non-public client presentation. Do NOT enable for real users.
CLIENT_DEMO_MODE=false
CLIENT_DEMO_OTP=false
# Vercel frontend -> Render proxy (optional; set only on Vercel; Render hosts MongoDB backend)
RENDER_API_ORIGIN=
# Comma/ single origin for server request checks (e.g. https://cassiams.vercel.app)
APP_ORIGIN=
